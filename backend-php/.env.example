# Copie este arquivo para .env e preencha. Sem SMTP_HOST, o e-mail roda em modo simulado.

# ---- Gmail (precisa de "senha de app": myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=seuemail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=seuemail@gmail.com
SMTP_FROM_NAME=Roteiro de Viagem

# ---- Resend (recomendado para producao, dominio proprio verificado)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# SMTP_USER=resend
# SMTP_PASS=re_sua_chave_api
# SMTP_FROM=contato@seudominio.com.br

# ---- Conteudo
# EBOOK_PATH=assets/ebook_exemplo.pdf
# REGULAMENTO_URL=https://seusite.com.br/regulamento

# ---- Acesso ao painel: primeiro administrador (minimo 8 caracteres)
# ADMIN_NOME=Seu nome
# ADMIN_EMAIL=voce@empresa.com.br
# ADMIN_SENHA=troque-esta-senha

# ---- Pagamento: simulado (botao na tela), infinitepay ou asaas
PAGAMENTO=simulado

# InfinitePay (Checkout Integrado): InfiniteTag sem o $. Ative o checkout externo no app da InfinitePay
# INFINITEPAY_HANDLE=sua-tag
# URL_PUBLICA=https://seusite.com.br   (opcional: endereco de volta e do webhook; padrao e o dominio da requisicao)

# Asaas: chave entre aspas simples por causa do $ ; token do webhook e um texto aleatorio seu
# ASAAS_URL=https://api.asaas.com/v3          (sandbox: https://api-sandbox.asaas.com/v3)
# ASAAS_API_KEY='$aact_...'
# ASAAS_WEBHOOK_TOKEN=gere-um-texto-aleatorio-longo

# ---- Banco de dados: sqlite (padrao, arquivo data/poc.db) ou mysql
# Para levar os dados do SQLite ao MySQL: php ferramentas/sqlite_para_mysql.php
DB_DRIVER=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=numero_sorte
# DB_USER=usuario
# DB_PASS=senha
